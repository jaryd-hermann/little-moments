EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Web OAuth client ID from Google Cloud (same project as Supabase Google auth)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-client-id.apps.googleusercontent.com
# iOS OAuth client ID (type "iOS", bundle com.jarydhermann.littlemoments) — required on iOS without GoogleService-Info.plist
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your-ios-client-id.apps.googleusercontent.com

# Server-side only — NEVER expose these in client bundles
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
ANTHROPIC_API_KEY=your-anthropic-api-key
# OpenAI — text embeddings for Threads (Edge Function secret: supabase secrets set OPENAI_API_KEY=sk-...)
OPENAI_API_KEY=your-openai-api-key

EXPO_PUBLIC_REVENUECAT_IOS_KEY=your-revenuecat-ios-api-key

# OneSignal (https://documentation.onesignal.com/docs/en/react-native-expo-sdk-setup)
# Add the same EXPO_PUBLIC_ONESIGNAL_APP_ID to EAS build env (eas.json or EAS Secrets) for cloud builds.
EXPO_PUBLIC_ONESIGNAL_APP_ID=your-onesignal-app-uuid
# APNs + OneSignal NSE: development for dev client / simulator; production for TestFlight/App Store (default if unset).
# EXPO_PUBLIC_ONESIGNAL_APN_ENV=development
# EXPO_PUBLIC_ONESIGNAL_APN_ENV=production
# Server-side OneSignal (Supabase Edge Function secrets, used by cron-evening-pushes):
#   supabase secrets set ONESIGNAL_APP_ID=<same UUID as EXPO_PUBLIC_ONESIGNAL_APP_ID>
#   supabase secrets set ONESIGNAL_REST_API_KEY=<from OneSignal dashboard → Settings → Keys & IDs>
ONESIGNAL_APP_ID=your-onesignal-app-uuid
ONESIGNAL_REST_API_KEY=your-onesignal-rest-api-key
# Public URL of the daily-nudge hero image (e.g. push-mock.png uploaded to Supabase Storage public bucket).
# Set as Edge Function secret: supabase secrets set PUSH_MOCK_URL=https://...
PUSH_MOCK_URL=https://smwmkeoljqnifaoqzemb.supabase.co/storage/v1/object/public/brand/push-mock.png

# PostHog analytics (https://posthog.com)
EXPO_PUBLIC_POSTHOG_API_KEY=your-posthog-api-key
# Server-side PostHog (Edge Functions → PostHog Logs via OTLP/HTTP).
# Same `phc_...` token as EXPO_PUBLIC_POSTHOG_API_KEY — separate env name
# so we never accidentally bundle it into the client.
#   supabase secrets set POSTHOG_PROJECT_TOKEN=phc_xxx
#   supabase secrets set DEPLOYMENT_ENVIRONMENT=production   # optional
POSTHOG_PROJECT_TOKEN=phc_xxx
# Optional override for EU cloud — defaults to https://us.i.posthog.com.
# POSTHOG_HOST=https://eu.i.posthog.com

# Resend (transactional email — https://resend.com)
# Set as Supabase Edge Function secret: supabase secrets set RESEND_API_KEY=re_xxxx
RESEND_API_KEY=your-resend-api-key
# Resend audience (a.k.a. Segment) UUID — new signups are auto-added by
# send-welcome-email and bulk-backfilled by backfill-resend-audience so you can
# fire Broadcasts from the Resend dashboard. Find the id under Audiences in
# the Resend dashboard URL.
#   supabase secrets set RESEND_AUDIENCE_ID=<uuid>
RESEND_AUDIENCE_ID=your-resend-audience-uuid
# Optional: override wordmark URL for HTML emails (default matches public Storage object below)
# WORDMARK_URL=https://smwmkeoljqnifaoqzemb.supabase.co/storage/v1/object/public/brand/wordmark-little-moments-black.png
