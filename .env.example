EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Web OAuth client ID from Google Cloud (same project as Supabase Google auth)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-client-id.apps.googleusercontent.com
# iOS OAuth client ID (type "iOS", bundle com.jarydhermann.littlemoments) — required on iOS without GoogleService-Info.plist
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your-ios-client-id.apps.googleusercontent.com

# Server-side only — NEVER expose these in client bundles
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
ANTHROPIC_API_KEY=your-anthropic-api-key

EXPO_PUBLIC_REVENUECAT_IOS_KEY=your-revenuecat-ios-api-key

# OneSignal (https://documentation.onesignal.com/docs/en/react-native-expo-sdk-setup)
EXPO_PUBLIC_ONESIGNAL_APP_ID=your-onesignal-app-uuid
# Use production for TestFlight/App Store builds; omit or development for local/dev client
# EXPO_PUBLIC_ONESIGNAL_APN_ENV=production

# PostHog analytics (https://posthog.com)
EXPO_PUBLIC_POSTHOG_API_KEY=your-posthog-api-key

# Resend (transactional email — https://resend.com)
# Set as Supabase Edge Function secret: supabase secrets set RESEND_API_KEY=re_xxxx
RESEND_API_KEY=your-resend-api-key
